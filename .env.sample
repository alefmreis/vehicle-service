APP_ENV=dev

AWS_DYNAMO_DB_ACCESS_KEY=
AWS_DYNAMO_DB_ACCESS_SECRET=
AWS_DYNAMO_DB_ENDPOINT=
AWS_DYNAMO_DB_REGION=

# CORS Configuration - Comma-separated list of allowed origins, or * for all
# Example: https://myapp.com,https://staging.myapp.com
# For security, avoid using * in production
CORS_ALLOWED_ORIGINS=*

# JWT Secret Key - MUST be at least 32 characters long
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET_KEY=

LOG_LEVEL=info

PORT=3000

