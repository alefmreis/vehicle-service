APP_ENV=test

AWS_DYNAMO_DB_ACCESS_KEY=local
AWS_DYNAMO_DB_ACCESS_SECRET=local
AWS_DYNAMO_DB_ENDPOINT=http://localhost:8000
AWS_DYNAMO_DB_REGION=us-east-1

# CORS Configuration for testing
CORS_ALLOWED_ORIGINS=*

# JWT Secret Key for testing - at least 32 characters
JWT_SECRET_KEY=test-jwt-secret-key-for-testing-only-minimum-32-chars

LOG_LEVEL=warn

PORT=3000


